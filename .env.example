# Environment Variables Template voor Reau Website (Netlify)
# Stel deze variabelen in via het Netlify Dashboard (Site configuration > Environment variables)

# Brevo (Sendinblue) Transactionele E-mail API Key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

# Afzender en ontvanger configuratie
SENDER_EMAIL=info@haagseopenmic.nl
# Het e-mailadres waar de aanvragen direct in moeten binnenkomen (bijv. halfhide@gmail.com)
NOTIFICATION_EMAIL=halfhide@gmail.com
# Het officiële publieke boekingsadres dat klanten te zien krijgen (reply-to en voetteksten)
PUBLIC_BOOKING_EMAIL=boekingen@reaumusic.nl

# Cloudflare Turnstile Bot Protection (Optioneel / Aanbevolen voor productie)
# Maak een gratis Turnstile widget aan via https://dash.cloudflare.com/ (Turnstile)
# Test Site Key: 1x00000000000000000000AA
# Test Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
